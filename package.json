{
  "name": "@studyspot/monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- concurrently \"pnpm dev:web\" \"pnpm dev:assistant\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @studyspot/web dev",
    "dev:assistant": "sh -c 'cd workers/assistant/.mastra/output && wrangler dev --local --persist-to .wrangler/state'",
    "dev:assistant-remote": "sh -c 'cd workers/assistant/.mastra/output && wrangler dev --remote --persist-to .wrangler/state'",
    "dev:remote": "concurrently \"pnpm dev:web\" \"pnpm dev:assistant-remote\"",
    "dev:cloudflare": "pnpm build && concurrently \"cd apps/web && pnpm dev:wrangler\" \"pnpm dev:assistant\"",
    "build": "pnpm build:web && pnpm build:assistant",
    "build:web": "cd apps/web && dotenv -e .env.production -- pnpm build:cloudflare",
    "build:assistant": "cd workers/assistant && pnpm build",
    "deploy": "pnpm deploy:web && pnpm deploy:assistant",
    "deploy:web": "cd apps/web && npx @opennextjs/cloudflare@latest deploy",
    "deploy:assistant": "cd workers/assistant/.mastra/output && wrangler deploy --config wrangler.json",
    "secrets:list:assistant": "cd workers/assistant && wrangler secret list",
    "secrets:set:assistant": "cd workers/assistant && wrangler secret put",
    "secrets:list:web": "cd apps/web && wrangler secret list",
    "secrets:set:web": "cd apps/web && wrangler secret put",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@next/eslint-plugin-next": "^15.4.3",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.31.0",
    "typescript": "^5"
  }
}

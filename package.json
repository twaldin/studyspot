{
  "name": "@studyspot/monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:vercel\"",
    "dev:web": "pnpm --filter @studyspot/web dev",
    "dev:api": "pnpm --filter @studyspot/assistant-api dev",
    "dev:vercel": "pnpm --filter @studyspot/assistant-api dev:vercel",
    "build": "pnpm --filter @studyspot/web build && pnpm --filter @studyspot/assistant-api build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5"
  }
}
{
  "name": "@studyspot/monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @studyspot/web exec -- sh -c 'dotenv -e ../../.env next dev --turbopack | pino-pretty'",
    "dev:api": "pnpm --filter @studyspot/assistant-api dev",
    "dev:panel": "pnpm --filter @studyspot/dev-panel dev",
    "dev:all": "concurrently \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:panel\"",
    "build": "pnpm --filter @studyspot/web build && pnpm --filter @studyspot/assistant-api build && pnpm --filter @studyspot/dev-panel build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@next/eslint-plugin-next": "^15.4.3",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.31.0",
    "typescript": "^5"
  }
}
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.open-next/

# production
/build

# misc
.DS_Store
*.pem
.npmrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
.wrangler

# mastra build output
.mastra/
workers/*/.mastra/

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# claude development files
CLAUDE.local.md

# Application-specific ignores
apps/*/.next/
apps/*/node_modules/
apps/*/dist/
apps/*/.turbo/

# Workers-specific ignores
workers/*/node_modules/
workers/*/.dev.vars
workers/*/.wrangler/
workers/*/dist/
workers/*/.cache/
workers/*/.mastra/

# Temporary and backup files
*.log
*.backup.*
*CHECKLIST.md
*TROUBLESHOOTING.md
*TEST_*.md
test-*.sh
add-*.sh
